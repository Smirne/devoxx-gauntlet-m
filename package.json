{
  "name": "after-dark",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "After Dark — a Devoxx Belgium Robot Games entry. Voxxy, Droid and Biggy prep Kinepolis Antwerp before doors open.",
  "license": "MIT",
  "scripts": {
